	(text "BLOCK STUB (rev A block diagram). Contents planned:"
		(exclude_from_sim no)
		(at 76.20 30.48 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "a94c1521-8e17-4335-bce7-23457ecdff3f")
	)
	(text "- U1 Socket AM5 LGA1718 (Foxconn PE17181/PE17186 or Lotes AZIFS055), MP62 contact frame on the 69.5 x 55 core holes (no stock ILM)"
		(exclude_from_sim no)
		(at 76.20 35.56 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "2350da8c-43a7-464e-b7ec-3329a3b9a7eb")
	)
	(text "- v3 CPU: Ryzen 7000/9000 (Raphael / Granite Ridge), 65 W TDP (PPT 88 W); Dasharo not required for v3 (vendor AGESA UEFI); 8000G no longer the target"
		(exclude_from_sim no)
		(at 76.20 39.37 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "48710231-b073-4dfc-a6bd-80e6f02c5262")
	)
	(text "- 7000/9000 PCIe: 28 lanes / 24 usable = GFX x16 Gen5 (Face P) + GPP#1 x4 (Face S slot A) + GPP#2 x4 (Face S slot B, CPU-LINK v3) + x4 PROM21 uplink"
		(exclude_from_sim no)
		(at 76.20 43.18 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "7e80e47d-4714-42b4-8622-72876cdb4628")
	)
	(text "- GFX lanes 0-15 all live (x16); slot B GPP#2 lanes 4-7 on CPU-LINK v3 (BP v3 routes lanes 4-5 = x2); M.2 boot J8 moves to a PROM21 Gen4 x4 port"
		(exclude_from_sim no)
		(at 76.20 46.99 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "e21cd3ec-0efe-430c-9409-781b406b88ff")
	)
	(text "- USB: 2 x USB 10G -> J3 C1/C2, 1 x USB2 -> CPU-LINK SPARE; 2 x USB4 unused in rev A (option: run them at 10G instead of the hub [firmware risk])"
		(exclude_from_sim no)
		(at 76.20 50.80 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "908e7c1b-9218-413b-8a09-0d7f7d162aaa")
	)
	(text "- Display: DP0 4-lane -> J3 DDIB, DP1 2-lane -> J3 DDIC (AUX AC-coupled, HPD from the IOB); 7000/9000 iGPU = 2 lanes class TBD"
		(exclude_from_sim no)
		(at 76.20 54.61 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "f789c8c8-9548-43e4-a17b-ab8679f21e1b")
	)
	(text "- FCH (in the CPU): GPP_CLK refclks (closes U-12 on AM5), SPI ROM, SMBus0 (SPD), SLP_S3_L/SLP_S5_L, RSMRST_L, PWR_GOOD, PCIE_RST_L, THERMTRIP_L, PROCHOT_L"
		(exclude_from_sim no)
		(at 76.20 58.42 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "1e21e986-3f04-43fe-9538-9512d4a14ec3")
	)
	(text "- Pin names are functional placeholders: the AM5 pin list/land map is AMD NDA"
