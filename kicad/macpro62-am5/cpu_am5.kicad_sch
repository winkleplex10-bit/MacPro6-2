	)
	(text "- U1 Socket AM5 LGA1718 (Foxconn PE17181/PE17186 or Lotes AZIFS055), MP62 contact frame on the 69.5 x 55 core holes (no stock ILM)"
		(exclude_from_sim no)
		(at 76.20 35.56 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "1ed3c3e8-7815-4d98-8642-2e90f7c77d85")
	)
	(text "- Primary CPU: Ryzen 8000G (Phoenix) - the only AM5 family Dasharo (coreboot + openSIL) boots today; cTDP 45 W (PPT ~61 W)"
		(exclude_from_sim no)
		(at 76.20 39.37 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "61fe328a-fc93-4b40-aecc-86ab63693b57")
	)
	(text "- 8000G PCIe 4.0: 20 lanes / 16 usable = GFX x8 (Face P) + GPP x4 (Face S) + GPP x4 (M.2 boot) + x4 PROM21 uplink"
		(exclude_from_sim no)
		(at 76.20 43.18 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "360a83b3-53d6-47b6-9e49-a36525bbb95b")
	)
	(text "- GFX lanes 8-15 are routed to J1 but unused by 8000G; live with Ryzen 7000/9000 (x16 Gen5, AC caps fitted)"
		(exclude_from_sim no)
		(at 76.20 46.99 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "5c749796-70c7-412a-9fbb-8ec73169fd8b")
	)
	(text "- USB: 2 x USB 10G -> J3 C1/C2, 1 x USB2 -> CPU-LINK SPARE; 2 x USB4 unused in rev A (option: run them at 10G instead of the hub [firmware risk])"
		(exclude_from_sim no)
		(at 76.20 50.80 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "3d312b0d-cd31-42e8-9189-7f229fdfd655")
	)
	(text "- Display: DP0 4-lane -> J3 DDIB, DP1 2-lane -> J3 DDIC (AUX AC-coupled, HPD from the IOB); 7000/9000 iGPU = 2 lanes class TBD"
		(exclude_from_sim no)
		(at 76.20 54.61 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "d1a37443-bb76-4342-8343-20c3e3f4643b")
	)
	(text "- FCH (in the CPU): GPP_CLK refclks (closes U-12 on AM5), SPI ROM, SMBus0 (SPD), SLP_S3_L/SLP_S5_L, RSMRST_L, PWR_GOOD, PCIE_RST_L, THERMTRIP_L, PROCHOT_L"
