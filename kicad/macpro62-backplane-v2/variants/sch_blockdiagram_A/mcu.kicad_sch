	)
	(text "- U1 RP2350A (LCSC C42411118) + U2 16 MB QSPI flash + 12 MHz crystal; SWD (J8), BOOTSEL (SW1)"
		(exclude_from_sim no)
		(at 76.20 35.56 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "04ee9b7e-b0df-45b3-8efa-f6edeb030aa2")
	)
	(text "- USB FS composite device to the host (HID sensors + vendor HID) via CPU-LINK USB2"
		(exclude_from_sim no)
		(at 76.20 39.37 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "1c009a4e-6397-42fe-82cd-efe141238b2f")
	)
	(text "- Power sequencing (S5/S0 only in rev A), face power policy; LIVE POWER TARGET (arch spec 5.5 / ICD 13.2): 445 W ceiling, 10 Hz loop"
		(exclude_from_sim no)
		(at 76.20 43.18 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "ac4b31b6-fa83-4aba-9dfd-eaa73cb90b66")
	)
	(text "- LPT telemetry: INA228 BP 0x40 + IOB 0x41 (I2C_SYS), CB 0x45 (MOD_I2C0), faces 0x40 (FACE_x_SMB); alerts: PWR_ALERT_BP_N, MOD_PWR_ALERT_N, IOB_INT_N, FACE_x_SMB_ALERT_N"
		(exclude_from_sim no)
		(at 76.20 46.99 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "f1cf8af3-0f81-48df-8b9c-995a8dfeb3af")
	)
	(text "- LPT actuators: EC (UART0: PL1/PL2/PL4, ratio cap) + MOD_CARRIER_HOT_N (PROCHOT#), FACE_x_THERM_ALERT_N (fast cap), face power-target register, PD pool via I2C_PD"
		(exclude_from_sim no)
		(at 76.20 50.80 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "43b5c258-fd5f-4239-818c-efe977e03a32")
	)
	(text "- Fan: reads the CB demand (MOD_FAN_PWMOUT) and drives the IOB EMC2101 (0x4C on I2C_PD behind TCA9517); reloads LUT + TCRIT at every S0 entry (fail-safe)"
		(exclude_from_sim no)
		(at 76.20 54.61 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "cc135902-9bd3-42e8-95f0-f5526b5b3d30")
	)
	(text "- Owns FACE_P/FACE_S SMBus segments (ID EEPROM 0x50, temp sensor 0x48)"
		(exclude_from_sim no)
		(at 76.20 58.42 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "ab173e25-bdc7-4366-86b9-d69fca921857")
	)
	(text "- I2C_SYS: INA 0x40, TMP1075 U3 0x48 / U4 0x49, BP EEPROM 0x50; IOB: LIS2DH12 0x18, EMC2101 0x4C, EEPROM 0x51, TLC59116 0x60"
		(exclude_from_sim no)
		(at 76.20 62.23 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "a78dd5de-378a-494d-8382-6bae58ac89a1")
	)
	(text "- MOD_I2C0 (CPU-LINK B90/B92) = CB ID EEPROM 0x57; MOD_SMB = PCH SMBus (DIMM SPD) -> BP leaves it isolated (DNP) by default"
		(exclude_from_sim no)
