				(thickness 0.135)
			)
		)
	)
	(gr_text "Port grid: columns Xb 42.6 / 63.9; USB-C rows Y 75.2 / 65.45 / 55.7; USB-A rows 42.75 / 32.6; RJ45 Y ~92; HDMI (42.4,107.4); button (63.0,108.0)."
