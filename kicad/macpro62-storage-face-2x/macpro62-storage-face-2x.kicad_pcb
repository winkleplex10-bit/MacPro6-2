			)
			(justify mirror)
		)
	)
	(gr_text "MP62 Face S storage module S2X rev A0: 2 x M.2 2280 NVMe x4 (no PCIe switch). Viewed from the CORE side. F = core side, B = outer side."
		(at 112 196 0)
		(layer "Cmts.User")
		(uuid "0c2e7850-804e-4308-b588-b79f177eaf19")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(gr_text "Deviations: D-2X-1 hot-spot centroid ~(58, 75); D-S1 no X-bracket (as SM-1). Single-sided assembly (JLC Economic eligible)."
		(at 112 202.6 0)
		(layer "Cmts.User")
		(uuid "476bc6e3-83e8-4ae6-b50c-79239457f0eb")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(gr_text "Top band B: TPS259470A eFuse (EN = FACE_PWR_EN, ILIM 3.3 A), 2 mOhm shunt + INA238 @0x40. Strips: 2 x TPS54331 3V3 3 A bucks."
		(at 112 200.4 0)
		(layer "Cmts.User")
		(uuid "cf4554ea-b924-4a60-9ce7-f50edb6fb777")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(gr_text "J_PCIE MCIO124 x8 = x4 slot A (lanes 0-3, REFCLK0, PERST0#) + x4 slot B (lanes 4-7, REFCLK1, PERST1#): host PEG 2x8 / x4x4 bifurcation."
		(at 112 198.2 0)
		(layer "Cmts.User")
		(uuid "fdda85f5-a561-46d6-98ca-9e47aa0ef913")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
